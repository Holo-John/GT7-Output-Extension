{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Unit Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "test"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src${pathSeparator}${workspaceFolder}/test"
            },
            "justMyCode": false
        }
    ]
}