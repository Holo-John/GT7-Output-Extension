<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>GT7 Test Output</name>
  <id>gt7.output.optimized</id>

  <output class="GT7Export" saveas="True">
    <extension>.gt7</extension>
    <mimetype>image/svg+xml</mimetype>
    <filetypename>Gran Turismo 7 (*.gt7)</filetypename>
    <filetypetooltip>Optimized SVG for Gran Turismo 7 Livery Editor</filetypetooltip>
  </output>

  <script>
    <command interpreter="python" location="inx">gt7_export.py</command>
  </script>
</inkscape-extension>




